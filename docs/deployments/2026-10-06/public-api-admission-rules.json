      "active": true,
      "description": "Fresh public API address per-client limit. Does not match core UI, ingestion or workflow routes.",
      "conditionGroup": [
        {
          "conditions": [
            {
              "type": "rate_limit_api_id",
              "op": "eq",
              "value": "namepass-v1-address-ip"
            }
          ]
        }
      ],
      "action": {
        "mitigate": {
          "action": "rate_limit",
          "rateLimit": {
            "limit": 6,
            "action": "rate_limit",
            "window": 60,
            "algo": "fixed_window",
